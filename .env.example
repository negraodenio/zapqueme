# Inference (OpenRouter is preferred for production; per-request privacy controls are applied)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Direct Gemini fallback is disabled in production unless explicitly enabled.
# Set ALLOW_GEMINI_FALLBACK=true only after confirming the account/API terms.
GEMINI_API_KEY=...
GEMINI_API_KEY_BACKUP=...
ALLOW_GEMINI_FALLBACK=false

# Upstash Redis: rate limits, counters, leads fallback, and WhatsApp session storage
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Supabase server-side only. Never expose the service role key in browser code.
SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared admin secret for the admin dashboard and WhatsApp pairing dashboard (use 32+ random characters)
ADMIN_SECRET_KEY=...
WHATSAPP_PHONE=351...
AUTO_PAIRING=false
WHATSAPP_SESSION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WHATSAPP_MESSAGES_PER_MINUTE=12

# Optional SMS webhook: use a provider that sends this header.
SMS_WEBHOOK_SECRET=...
